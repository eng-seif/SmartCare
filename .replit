modules = ["nodejs-24", "python-base-3.13", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 180000

[nix]
channel = "stable-25_05"
packages = ["flutter", "jdk17", "unzip"]

[userenv]

[userenv.shared]
NEXT_PUBLIC_SUPABASE_URL = "https://luukvzyqieutnpfwlzqr.supabase.co"

[objectStorage]
defaultBucketID = "replit-objstore-37540426-60c2-41d9-b8e7-3b3e2798c9d6"
